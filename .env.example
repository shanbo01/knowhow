# Runtime identity. Use separate Appwrite projects and secrets for local,
# Staging, and Production. Azure self-hosting uses
# azure-self-hosted:<arm-region>; temporary Cloud fallback uses
# appwrite-cloud-frankfurt.
KNOWHOW_ENVIRONMENT=development
NEXT_PUBLIC_KNOWHOW_ENVIRONMENT=development
KNOWHOW_RELEASE=local
NEXT_PUBLIC_KNOWHOW_RELEASE=local
NEXT_PUBLIC_KNOWHOW_PUBLIC_SIGNUP_ENABLED=0
KNOWHOW_APPWRITE_RESIDENCY=azure-self-hosted:southindia

APPWRITE_ENDPOINT=https://replace-with-azure-host.southindia.cloudapp.azure.com/v1
# Server-side Appwrite Sites use a private runtime-network alias to avoid
# recursively calling the public synchronous Sites proxy.
APPWRITE_INTERNAL_ENDPOINT=http://appwrite-internal/v1
APPWRITE_PROJECT_ID=replace-with-project-id
APPWRITE_API_KEY=replace-with-server-api-key
APPWRITE_DATABASE_ID=knowhow_core
APPWRITE_PRIVATE_MEDIA_BUCKET_ID=knowhow_private_media
APPWRITE_EXPORTS_BUCKET_ID=knowhow_exports

# Set the same random value on the Site and export Function. The export
# Function also needs the deployed Site's canonical HTTPS origin.
KNOWHOW_EXPORT_WORKER_SECRET=replace-with-at-least-32-random-bytes
KNOWHOW_SITE_ORIGIN=https://staging.example.com

KNOWHOW_ALLOWED_ORIGINS=http://localhost:3001
KNOWHOW_PUBLIC_SIGNUP_ENABLED=0
KNOWHOW_EXTENSION_ORIGINS=chrome-extension://phbofjenfnnnnndghhinoldlfbpaedpo
KNOWHOW_EXTENSION_MIN_VERSION=0.1.0
NEXT_PUBLIC_KNOWHOW_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/replace-with-unlisted-listing
NEXT_PUBLIC_KNOWHOW_EDGE_EXTENSION_URL=https://microsoftedge.microsoft.com/addons/detail/replace-with-unlisted-listing
KNOWHOW_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes
KNOWHOW_TOKEN_KEYS_JSON={"v1":"replace-with-at-least-32-random-bytes"}
KNOWHOW_TOKEN_ACTIVE_KID=v1

# These addresses receive metadata-only operational notifications. They never
# grant platform authority; platform_roles is the only authority source.
KNOWHOW_PLATFORM_OWNER_EMAILS=owner@example.com
KNOWHOW_SUPPORT_EMAIL=support@example.com
KNOWHOW_LEADS_EMAIL=pilots@example.com

# Sentry must remain PII-disabled. Source-map upload credentials are build-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Configure these on the operations Function, not as public browser variables.
KNOWHOW_WEB_ORIGIN=http://localhost:3001
KNOWHOW_DELETION_RECEIPT_PEPPER=replace-with-at-least-32-random-bytes
RESEND_API_KEY=
RESEND_FROM=KnowHow <notifications@example.com>

# Build-only; required by `npm run extension:build:store` and never exposed as
# a secret. Store artifacts are written under ignored outputs/extension.
KNOWHOW_EXTENSION_ORIGIN=https://staging.example.com

# Release-gate inputs only. Keep account passwords and TOTP seeds in the
# approved secret runner; never set them on the deployed Site or Functions.
# Controlled smoke is mutating and must bind the supplied project to reviewed,
# distinct Staging/Production project IDs before creating transient fixtures.
KNOWHOW_SMOKE_SITE_ORIGIN=https://staging.example.com
KNOWHOW_SMOKE_REQUIRE_EMAIL_PROVIDER=1
KNOWHOW_SMOKE_REQUIRE_READY=1
KNOWHOW_SMOKE_EXPECTED_PROJECT_ID=
KNOWHOW_SMOKE_FORBIDDEN_PROJECT_ID=
KNOWHOW_SMOKE_MUTATION_CONFIRM=staging-transient-fixtures
KNOWHOW_SMOKE_EXPECTED_RELEASE=
KNOWHOW_SMOKE_SYNTHETIC_ONLY=0
KNOWHOW_SMOKE_FINAL_PRODUCTION=0

KNOWHOW_E2E_BASE_URL=https://staging.example.com
KNOWHOW_REQUIRE_CONTROLLED_REHEARSAL=0
KNOWHOW_E2E_EXPECTED_ENVIRONMENT=staging
KNOWHOW_E2E_EXPECTED_PROJECT_ID=
KNOWHOW_E2E_EXPECTED_RELEASE=
KNOWHOW_E2E_OWNER_EMAIL=
KNOWHOW_E2E_OWNER_PASSWORD=
KNOWHOW_E2E_OWNER_TOTP_SECRET=
KNOWHOW_E2E_MEMBER_EMAIL=
KNOWHOW_E2E_MEMBER_PASSWORD=
KNOWHOW_E2E_MEMBER_TOTP_SECRET=
KNOWHOW_E2E_WORKSPACE_SLUG=
KNOWHOW_E2E_PUBLISHED_GUIDE_ID=

# Controlled network-load gate only. The actor JSON stays in the approved
# secret runner and contains dedicated verified accounts, TOTP seeds, distinct
# load workspaces, tenant-specific search sentinels, and no customer data.
# Staging requires at least three 100-member tenants; Production uses exactly
# two dedicated actors in distinct load workspaces so the final user purge can
# still prove that only the approved two synthetic Auth accounts existed.
KNOWHOW_NETWORK_LOAD_ENVIRONMENT=staging
KNOWHOW_NETWORK_LOAD_SITE_ORIGIN=https://staging.example.com
KNOWHOW_NETWORK_LOAD_EXPECTED_PROJECT_ID=
KNOWHOW_NETWORK_LOAD_FORBIDDEN_PROJECT_ID=
KNOWHOW_NETWORK_LOAD_EXPECTED_RELEASE=
KNOWHOW_NETWORK_LOAD_CONFIRM=staging-synthetic-network-load
KNOWHOW_NETWORK_LOAD_SYNTHETIC_ONLY=0
KNOWHOW_NETWORK_LOAD_DEDICATED_ACTORS=0
KNOWHOW_NETWORK_LOAD_FINAL_PRODUCTION=0
KNOWHOW_NETWORK_LOAD_EXTENSION_ORIGIN=chrome-extension://phbofjenfnnnnndghhinoldlfbpaedpo
KNOWHOW_NETWORK_LOAD_EXTENSION_VERSION=0.1.0
KNOWHOW_NETWORK_LOAD_SYNTHETIC_EMAIL_DOMAIN=load.example.com
KNOWHOW_NETWORK_LOAD_ACTORS_JSON=[]
KNOWHOW_NETWORK_LOAD_EXPECTED_TENANTS=3
KNOWHOW_NETWORK_LOAD_MINIMUM_MEMBERS=100
KNOWHOW_NETWORK_LOAD_READERS_PER_TENANT=110
KNOWHOW_NETWORK_LOAD_CAPTURES_PER_TENANT=12
KNOWHOW_NETWORK_LOAD_REQUEST_TIMEOUT_MS=30000
KNOWHOW_NETWORK_LOAD_SEARCH_P95_MS=2000
KNOWHOW_NETWORK_LOAD_CAPTURE_P95_MS=10000
KNOWHOW_NETWORK_LOAD_EVIDENCE_HMAC_KEY=replace-with-at-least-32-random-bytes
KNOWHOW_NETWORK_LOAD_EVIDENCE_HMAC_KEY_ID=v1
KNOWHOW_NETWORK_LOAD_EVIDENCE_PATH=.tmp/controlled-network-load.json

# Backup/restore gate inputs only. Keep the HMAC key in the approved secret
# runner. Evidence paths must be outside the repository or beneath ignored
# `.tmp/`; use unique paths because the verifier never overwrites evidence.
KNOWHOW_BACKUP_POLICY_ID=
KNOWHOW_BACKUP_POLICY_ARCHIVE_ID=
KNOWHOW_BACKUP_ARCHIVE_ID=
KNOWHOW_BACKUP_EVIDENCE_HMAC_KEY=replace-with-at-least-32-random-bytes
KNOWHOW_BACKUP_EVIDENCE_HMAC_KEY_ID=v1
KNOWHOW_BACKUP_EVIDENCE_PATH=
KNOWHOW_BACKUP_SOURCE_FROZEN=0
KNOWHOW_BACKUP_SYNTHETIC_ONLY=0
KNOWHOW_RESTORE_RESTORATION_ID=
KNOWHOW_RESTORE_REPORT_PATH=
KNOWHOW_RESTORE_INCIDENT_AT=
KNOWHOW_RESTORE_ISOLATED=0
KNOWHOW_RESTORE_NOT_REFERENCED=0
KNOWHOW_RESTORE_SYNTHETIC_ONLY=0

# Disposable restored-application Site and application/RTO verifier only.
# The Site must use APPWRITE_DATABASE_ID equal to the new database below and a
# distinct Site origin, while retaining the Production project and stable empty
# bucket IDs. The proxy denies every request unless the private access header
# matches this secret. Offline evidence verification does not require the actor
# manifest, passwords/TOTP seeds, or access token.
KNOWHOW_RESTORE_APPLICATION_MODE=0
KNOWHOW_RESTORE_APPLICATION_CONFIRM=
KNOWHOW_RESTORE_APPLICATION_DATABASE_ID=
KNOWHOW_RESTORE_APPLICATION_SITE_ID=
KNOWHOW_RESTORE_APPLICATION_SITE_ORIGIN=
KNOWHOW_RESTORE_APPLICATION_SOURCE_SITE_ORIGIN=
KNOWHOW_RESTORE_APPLICATION_EXPECTED_PROJECT_ID=
KNOWHOW_RESTORE_APPLICATION_EXPECTED_RELEASE=
KNOWHOW_RESTORE_APPLICATION_SOURCE_PROJECT_ID=
KNOWHOW_RESTORE_APPLICATION_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
KNOWHOW_RESTORE_APPLICATION_SYNTHETIC_EMAIL_DOMAIN=restore.example.com
KNOWHOW_RESTORE_APPLICATION_ACTORS_JSON=[]
KNOWHOW_RESTORE_APPLICATION_REQUEST_TIMEOUT_MS=30000
KNOWHOW_RESTORE_APPLICATION_REPORT_PATH=
KNOWHOW_RESTORE_APPLICATION_ISOLATED=0
KNOWHOW_RESTORE_APPLICATION_NON_PUBLIC=0
KNOWHOW_RESTORE_APPLICATION_SYNTHETIC_ONLY=0
KNOWHOW_RESTORE_APPLICATION_EMAIL_DISABLED=0
KNOWHOW_RESTORE_APPLICATION_EXCLUSIVE=0

# Independent post-rehearsal absence proof. Run only after another operator has
# removed the restored database, disposable Site, temporary Auth platform, Site
# runtime key, and restore access secret. The verifier key is read-only with
# databases.read and sites.read and is revoked after offline seal verification.
KNOWHOW_RESTORE_CLEANUP_CONFIRM=
KNOWHOW_RESTORE_CLEANUP_REPORT_PATH=
KNOWHOW_RESTORE_CLEANUP_SECOND_OPERATOR=0
KNOWHOW_RESTORE_CLEANUP_PLATFORM_REMOVED=0
KNOWHOW_RESTORE_CLEANUP_RUNTIME_KEY_REVOKED=0
KNOWHOW_RESTORE_CLEANUP_ACCESS_SECRET_DESTROYED=0

# Final Production cleanup gate only. Supply the completed lifecycle receipt
# mappings and exactly two synthetic Appwrite user IDs from the secret runner.
# Output is HMAC-sealed with the backup evidence key above and never overwritten.
KNOWHOW_CLEANUP_TARGETS_JSON=[]
KNOWHOW_CLEANUP_USER_IDS_JSON=[]
KNOWHOW_CLEANUP_EXPECTED_PROJECT_ID=
KNOWHOW_CLEANUP_FORBIDDEN_PROJECT_ID=
KNOWHOW_CLEANUP_EXPECTED_RELEASE=
KNOWHOW_CLEANUP_EVIDENCE_PATH=
KNOWHOW_CLEANUP_SYNTHETIC_ONLY=0
KNOWHOW_CLEANUP_FINAL_PRODUCTION=0
