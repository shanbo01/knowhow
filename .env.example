# KnowHow has one supported runtime: the Next.js app and a self-hosted
# Appwrite installation on the local machine. Keep this file local-only.
KNOWHOW_ENVIRONMENT=development
NEXT_PUBLIC_KNOWHOW_ENVIRONMENT=development
KNOWHOW_RELEASE=local
NEXT_PUBLIC_KNOWHOW_RELEASE=local

# disabled | private_beta | open. The server value is authoritative; the
# public value only keeps the account UI in sync with the enforced policy.
KNOWHOW_REGISTRATION_MODE=open
NEXT_PUBLIC_KNOWHOW_REGISTRATION_MODE=open
KNOWHOW_SELF_SERVICE_WORKSPACE_LIMIT=1
KNOWHOW_LIFECYCLE_SIMULATION_ENABLED=0

# Local Appwrite. Do not replace either endpoint with a remote host.
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_INTERNAL_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=knowhow-local
APPWRITE_API_KEY=replace-with-local-server-api-key
APPWRITE_DATABASE_ID=knowhow_core
APPWRITE_PRIVATE_MEDIA_BUCKET_ID=knowhow_private_media
APPWRITE_EXPORTS_BUCKET_ID=knowhow_exports

KNOWHOW_SITE_ORIGIN=http://localhost:3001
KNOWHOW_WEB_ORIGIN=http://localhost:3001
KNOWHOW_ALLOWED_ORIGINS=http://localhost:3001
KNOWHOW_EXPORT_WORKER_SECRET=replace-with-at-least-32-random-bytes

# Extension access remains pinned to the locally built package ID.
KNOWHOW_EXTENSION_ORIGINS=chrome-extension://phbofjenfnnnnndghhinoldlfbpaedpo
KNOWHOW_EXTENSION_MIN_VERSION=0.1.0
NEXT_PUBLIC_KNOWHOW_CHROME_EXTENSION_URL=
NEXT_PUBLIC_KNOWHOW_EDGE_EXTENSION_URL=

# Application security keys. Generate unique random values for the local
# installation and never commit the populated .env.local file.
KNOWHOW_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes
KNOWHOW_TOKEN_KEYS_JSON={"v1":"replace-with-at-least-32-random-bytes"}
KNOWHOW_TOKEN_ACTIVE_KID=v1
KNOWHOW_DELETION_RECEIPT_PEPPER=replace-with-at-least-32-random-bytes

# Metadata-only operational addresses. These values never grant authority.
KNOWHOW_PLATFORM_OWNER_EMAILS=owner@example.com
KNOWHOW_SUPPORT_EMAIL=support@example.com
KNOWHOW_LEADS_EMAIL=leads@example.com

# Optional outbound integrations. Leave blank for a fully local setup.
RESEND_API_KEY=
RESEND_FROM=KnowHow <notifications@example.com>
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Run the checked-in worker handlers against local Appwrite. Mailpit must stay
# bound to loopback because messages can contain local invitation credentials.
KNOWHOW_LOCAL_WORKER_MODE=emulated
KNOWHOW_LOCAL_MAILPIT_URL=http://127.0.0.1:8025
KNOWHOW_LOCAL_WORKER_INTERVAL_MS=60000

# Optional local contract smoke while Next.js is running.
KNOWHOW_SMOKE_SITE_ORIGIN=http://localhost:3001
KNOWHOW_SMOKE_REQUIRE_EMAIL_PROVIDER=0
KNOWHOW_SMOKE_REQUIRE_READY=1

# Optional disposable end-to-end rehearsal.
KNOWHOW_E2E_BASE_URL=http://localhost:3001
KNOWHOW_REQUIRE_LOCAL_REHEARSAL=0
KNOWHOW_LOCAL_REHEARSAL_OWNER_EMAIL=
KNOWHOW_LOCAL_REHEARSAL_OWNER_PASSWORD=
KNOWHOW_LOCAL_REHEARSAL_MEMBER_EMAIL=
KNOWHOW_LOCAL_REHEARSAL_MEMBER_PASSWORD=
KNOWHOW_LOCAL_BETA_CODE=
