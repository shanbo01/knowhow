# Staging/production readiness template. Values below are intentionally invalid.
# Copy to the deployment secret store, replace every placeholder, and keep the
# populated profile out of source control.
KNOWHOW_ENVIRONMENT=staging
NEXT_PUBLIC_KNOWHOW_ENVIRONMENT=staging
KNOWHOW_RELEASE=replace-with-immutable-release-id
NEXT_PUBLIC_KNOWHOW_RELEASE=replace-with-immutable-release-id

KNOWHOW_REGISTRATION_MODE=private_beta
NEXT_PUBLIC_KNOWHOW_REGISTRATION_MODE=private_beta
KNOWHOW_SELF_SERVICE_WORKSPACE_LIMIT=1

# Exact HTTPS /v1 endpoints. KNOWHOW_APPWRITE_HOSTS is a comma-separated exact
# hostname[:port] allowlist shared by the public and internal endpoints.
KNOWHOW_APPWRITE_HOSTS=appwrite.staging.example.com
APPWRITE_ENDPOINT=https://appwrite.staging.example.com/v1
APPWRITE_INTERNAL_ENDPOINT=https://appwrite.staging.example.com/v1
APPWRITE_PROJECT_ID=replace-with-controlled-project-id
APPWRITE_API_KEY=replace-with-at-least-32-random-bytes
APPWRITE_DATABASE_ID=knowhow_core
APPWRITE_PRIVATE_MEDIA_BUCKET_ID=knowhow_private_media
APPWRITE_EXPORTS_BUCKET_ID=knowhow_exports

# Exact non-local HTTPS origins only. Add the configured extension ID only after
# the signed store package is known.
KNOWHOW_SITE_ORIGIN=https://staging.example.com
KNOWHOW_WEB_ORIGIN=https://staging.example.com
KNOWHOW_ALLOWED_ORIGINS=https://staging.example.com
KNOWHOW_PUBLIC_APP_ORIGIN=https://staging.example.com
KNOWHOW_EXTENSION_ORIGINS=
KNOWHOW_EXTENSION_MIN_VERSION=0.1.0
NEXT_PUBLIC_KNOWHOW_CHROME_EXTENSION_URL=
NEXT_PUBLIC_KNOWHOW_EDGE_EXTENSION_URL=

# Only publish Authenticode-signed artifacts and Tauri-signed updater metadata.
KNOWHOW_DESKTOP_MIN_VERSION=0.1.0
KNOWHOW_DESKTOP_UPDATE_ENDPOINT=https://updates.staging.example.com/desktop/stable/latest.json
NEXT_PUBLIC_KNOWHOW_DESKTOP_EXE_X64_URL=https://downloads.staging.example.com/KnowHow-Capture-x64-setup.exe
NEXT_PUBLIC_KNOWHOW_DESKTOP_MSI_X64_URL=https://downloads.staging.example.com/KnowHow-Capture-x64.msi
NEXT_PUBLIC_KNOWHOW_DESKTOP_EXE_ARM64_URL=https://downloads.staging.example.com/KnowHow-Capture-arm64-setup.exe
NEXT_PUBLIC_KNOWHOW_DESKTOP_MSI_ARM64_URL=https://downloads.staging.example.com/KnowHow-Capture-arm64.msi

# Generate unique high-entropy values in the deployment secret store.
KNOWHOW_EXPORT_WORKER_SECRET=replace-with-at-least-32-random-bytes
KNOWHOW_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-bytes
KNOWHOW_TOKEN_KEYS_JSON={"v1":"replace-with-at-least-32-random-bytes"}
KNOWHOW_TOKEN_ACTIVE_KID=v1
KNOWHOW_DELETION_RECEIPT_PEPPER=replace-with-at-least-32-random-bytes

# The worker service must expose an authenticated, release-aware readiness
# endpoint returning {"status":"ready","release":"<KNOWHOW_RELEASE>"}.
KNOWHOW_WORKER_HEALTH_URL=https://workers.staging.example.com/health/ready
KNOWHOW_WORKER_HEALTH_TOKEN=replace-with-at-least-32-random-bytes

KNOWHOW_PLATFORM_OWNER_EMAILS=owner@example.com
KNOWHOW_SUPPORT_EMAIL=support@example.com
KNOWHOW_LEADS_EMAIL=leads@example.com

# Paid entitlements remain disabled until an audited adapter and webhook path are
# implemented. Plan requests are leads and never grant paid access.
KNOWHOW_BILLING_PROVIDER=disabled

RESEND_API_KEY=replace-with-provider-key
RESEND_FROM=KnowHow <notifications@example.com>

# Controlled contract smoke. Run only against an isolated staging project; the
# script creates and exactly removes disposable rows, transactions, a file, and a user.
KNOWHOW_E2E_CONTROLLED=1
KNOWHOW_E2E_BASE_URL=https://staging.example.com
