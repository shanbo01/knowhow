{
  "name": "knowhow-it-ops",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "npm run typecheck && npm run lint && npm run build && npm run test:functions && npm run test:extension && npm run test:auth-client && npm run extension:build && npm run appwrite:check",
    "test:auth-client": "node --import tsx --test lib/auth-client.test.ts",
    "test:functions": "node --check functions/operations/src/main.js && node --check functions/export/src/main.js",
    "test:extension": "node --test extension/scripts/test-capture-core.mjs",
    "typecheck": "tsc --noEmit",
    "appwrite:generate": "node scripts/generate-appwrite-config.mjs",
    "appwrite:check": "node scripts/generate-appwrite-config.mjs --check && node scripts/check-appwrite-query-indexes.mjs",
    "appwrite:local:owner": "node --env-file-if-exists=.env.local scripts/bootstrap-local-owner.mjs",
    "appwrite:local:beta": "node --conditions react-server --import tsx --env-file-if-exists=.env.local scripts/create-local-beta-grant.ts",
    "workers:local:once": "node --env-file-if-exists=.env.local scripts/run-local-workers.mjs --once",
    "workers:local:watch": "node --env-file-if-exists=.env.local scripts/run-local-workers.mjs --watch",
    "workers:local:notifications": "node --env-file-if-exists=.env.local scripts/run-local-workers.mjs --notifications-only",
    "extension:build": "npm --prefix extension run build",
    "extension:build:store": "npm --prefix extension run build:store",
    "desktop:dev": "npm --prefix desktop run tauri dev",
    "desktop:check": "npm --prefix desktop run check && cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "desktop:build": "npm --prefix desktop run tauri build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern extension/dist --ignore-pattern .next --max-warnings=0",
    "release:check": "npm test && npm run desktop:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "appwrite": "^26.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "node-appwrite": "^27.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  },
  "type": "module"
}
